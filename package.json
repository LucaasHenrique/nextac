        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@bull-board/api": "^6.20.6",
        "@bull-board/fastify": "^6.20.6",
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^11.2.0",
        "@fastify/jwt": "^10.0.0",
        "@fastify/swagger": "^9.7.0",
        "@types/jsonwebtoken": "^9.0.10",
        "bcrypt": "^6.0.0",
        "bullmq": "^5.73.0",
        "dotenv": "^17.3.1",
        "drizzle-orm": "^0.45.1",
        "fastify": "^5.7.4",
